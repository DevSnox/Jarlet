#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}"

    while [[ -L "$source" ]]; do
        local dir
        dir="$(cd -P "$(dirname -- "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ "$source" == /* ]] || source="$dir/$source"
    done

    cd -P "$(dirname -- "$source")" && pwd
}

readonly SCRIPT_DIR="$(resolve_script_dir)"

usage() {
    cat >&2 <<'EOF'
Usage: jarlet <command> [args...]

Commands:
  setup <name> [template-file]
  start <name> [template-file] [--foreground] [--accept-eula]
  stop <name>
  plugin <name> [add|remove|update ...]

Run a command with no further args to see its own detailed usage.
EOF
}

main() {
    if (( $# < 1 )); then
        usage
        exit 2
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        setup)
            exec "$SCRIPT_DIR/server/setup.sh" "$@"
            ;;
        start)
            exec "$SCRIPT_DIR/server/start.sh" "$@"
            ;;
        stop)
            exec "$SCRIPT_DIR/server/stop.sh" "$@"
            ;;
        plugin)
            exec "$SCRIPT_DIR/plugin/plugin.sh" "$@"
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        *)
            usage
            printf 'Error: Unknown command: %s\n' "$subcommand" >&2
            exit 2
            ;;
    esac
}

main "$@"
